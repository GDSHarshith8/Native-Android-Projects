import java.util.*;

class User {
    String userId, name, email, mobile, address, password, role;

    User(String userId, String name, String email, String mobile, String address, String password, String role) {
        this.userId = userId;
        this.name = name;
        this.email = email;
        this.mobile = mobile;
        this.address = address;
        this.password = password;
        this.role = role;
    }
}

class Booking {
    static int counter = 1000;
    int bookingId;
    String userId, recName, recAddress, status;
    double amount;
    Date bookingDate;

    Booking(String userId, String recName, String recAddress, double amount) {
        this.bookingId = ++counter;
        this.userId = userId;
        this.recName = recName;
        this.recAddress = recAddress;
        this.amount = amount;
        this.status = "Booked";
        this.bookingDate = new Date();
    }
}

public class ParcelSystem {
    static ArrayList<User> users = new ArrayList<>();
    static ArrayList<Booking> bookings = new ArrayList<>();
    static Scanner sc = new Scanner(System.in);
    static User currentUser = null;

    public static void main(String[] args) {
        while (true) {
            System.out.println("\n1. Register\n2. Login\n3. Exit");
            int choice = sc.nextInt(); sc.nextLine();

            switch (choice) {
                case 1 -> register();
                case 2 -> login();
                case 3 -> System.exit(0);
            }
        }
    }

    // ✅ Registration
    static void register() {
        System.out.println("Enter User ID:");
        String userId = sc.nextLine();

        System.out.println("Enter Name:");
        String name = sc.nextLine();

        System.out.println("Enter Email:");
        String email = sc.nextLine();

        System.out.println("Enter Mobile:");
        String mobile = sc.nextLine();

        System.out.println("Enter Address:");
        String address = sc.nextLine();

        System.out.println("Enter Password:");
        String password = sc.nextLine();

        System.out.println("Enter Role (Customer/Officer):");
        String role = sc.nextLine();

        users.add(new User(userId, name, email, mobile, address, password, role));
        System.out.println("✅ Registration Successful");
    }

    // ✅ Login
    static void login() {
        System.out.println("Enter User ID:");
        String userId = sc.nextLine();

        System.out.println("Enter Password:");
        String password = sc.nextLine();

        for (User u : users) {
            if (u.userId.equals(userId) && u.password.equals(password)) {
                currentUser = u;
                System.out.println("✅ Login Successful");
                dashboard();
                return;
            }
        }
        System.out.println("❌ Invalid Credentials");
    }

    // ✅ Dashboard
    static void dashboard() {
        if (currentUser.role.equalsIgnoreCase("Customer"))
            customerMenu();
        else
            officerMenu();
    }

    // ✅ Customer Menu
    static void customerMenu() {
        while (true) {
            System.out.println("\n1.Book Service\n2.Track\n3.History\n4.Logout");
            int ch = sc.nextInt(); sc.nextLine();

            switch (ch) {
                case 1 -> bookService();
                case 2 -> track();
                case 3 -> history();
                case 4 -> { currentUser = null; return; }
            }
        }
    }

    // ✅ Officer Menu
    static void officerMenu() {
        while (true) {
            System.out.println("\n1.Track\n2.Update Status\n3.Update Pickup\n4.History\n5.Logout");
            int ch = sc.nextInt(); sc.nextLine();

            switch (ch) {
                case 1 -> track();
                case 2 -> updateStatus();
                case 3 -> updatePickup();
                case 4 -> history();
                case 5 -> { currentUser = null; return; }
            }
        }
    }

    // ✅ Booking Service
    static void bookService() {
        System.out.println("Receiver Name:");
        String name = sc.nextLine();

        System.out.println("Receiver Address:");
        String address = sc.nextLine();

        System.out.println("Enter Weight:");
        double weight = sc.nextDouble(); sc.nextLine();

        double cost = weight * 10;  // simple pricing

        Booking b = new Booking(currentUser.userId, name, address, cost);
        bookings.add(b);

        System.out.println("✅ Booking Done. ID: " + b.bookingId);
    }

    // ✅ Tracking
    static void track() {
        System.out.println("Enter Booking ID:");
        int id = sc.nextInt(); sc.nextLine();

        for (Booking b : bookings) {
            if (b.bookingId == id) {
                System.out.println(b.bookingId + " | " + b.recName + " | " + b.recAddress + " | " + b.status);
                return;
            }
        }
        System.out.println("❌ Not Found");
    }

    // ✅ Update Status
    static void updateStatus() {
        System.out.println("Enter Booking ID:");
        int id = sc.nextInt(); sc.nextLine();

        for (Booking b : bookings) {
            if (b.bookingId == id) {
                System.out.println("Enter Status (Booked/InTransit/Delivered/Returned):");
                b.status = sc.nextLine();
                System.out.println("✅ Updated");
                return;
            }
        }
        System.out.println("❌ Booking Not Found");
    }

    // ✅ Update Pickup
    static void updatePickup() {
        System.out.println("Enter Booking ID:");
        int id = sc.nextInt(); sc.nextLine();

        for (Booking b : bookings) {
            if (b.bookingId == id) {
