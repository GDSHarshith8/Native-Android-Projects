CREATE TABLE tbl_Booking (
    Booking_ID INT AUTO_INCREMENT PRIMARY KEY,
    User_ID INT,
    Rec_Name VARCHAR(100),
    Rec_Address VARCHAR(255),
    Rec_Pin VARCHAR(10),
    Rec_Mobile VARCHAR(15),
    Par_Weight_Gram INT,
    Par_Contents_Description VARCHAR(255),
    Par_Delivery_Type VARCHAR(50),
    Par_Packing_Preference VARCHAR(50),
    Par_PickupTime DATETIME,
    Par_DropoffTime DATETIME,
    Par_ServiceCost DECIMAL(10,2),
    Par_PaymentTime DATETIME,
    Par_Status VARCHAR(50),
    Booking_Date DATETIME DEFAULT GETDATE(),

    FOREIGN KEY (User_ID) REFERENCES tbl_UserProfile(User_ID)
);


