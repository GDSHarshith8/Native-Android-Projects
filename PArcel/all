# 3. RegisterServlet.java


import java.io.*;
import jakarta.servlet.*;
import jakarta.servlet.http.*;
import java.sql.*;

public class RegisterServlet extends HttpServlet {

protected void doPost(HttpServletRequest req, HttpServletResponse res)
throws ServletException, IOException {

    String email = req.getParameter("email");

    try {
        Connection con = DBConnection.getConnection();

        // Check Email Unique
        PreparedStatement check = con.prepareStatement(
            "SELECT * FROM users WHERE email=?");
        check.setString(1, email);

        ResultSet rs = check.executeQuery();

        if (rs.next()) {
            res.getWriter().println("Email Already Exists ❌");
            return;
        }

        PreparedStatement ps = con.prepareStatement(
            "INSERT INTO users VALUES(?,?,?,?,?,?)");

        ps.setString(1, req.getParameter("userid"));
        ps.setString(2, req.getParameter("name"));
        ps.setString(3, email);
        ps.setString(4, req.getParameter("mobile"));
        ps.setString(5, req.getParameter("address"));
        ps.setString(6, req.getParameter("password"));

        ps.executeUpdate();

        res.getWriter().println("Registration Successful");

    } catch (Exception e) {
        e.printStackTrace();
    }
}
}


